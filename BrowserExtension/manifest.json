{
  "manifest_version": 3,
  "name": "Muse Guard",
  "version": "0.1.0",
  "description": "A local guardian that checks web tabs proactively and interrupts only for confirmed high risk, with optional visual checks.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Muse Guard"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
