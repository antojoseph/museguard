.DS_Store
__pycache__/
*.pyc
*.blend1
*.blend2
*.blend@
.local/
.env
.env.*
**/auth.json
**/credentials.json
**/*-key.py
**/*-secret*
real.txt

# Preserve authored source and validation; leave generated caches local.
/work/*
!/work/*.py
!/work/*.npz
!/work/plush-*.txt
!/work/*-report.json
!/work/*-audit.json
!/work/rig-pose-checks.json
!/work/locomotion/
/work/locomotion/*
!/work/locomotion/*validation.json
!/work/locomotion/*refinement.json
!/work/locomotion/targets.json
!/work/locomotion/video-metadata.json
!/work/showcase/
/work/showcase/*
!/work/showcase/*validation.json
!/work/showcase/manifest.json
!/work/showcase/video-metadata.json

# Authentication and raw agent conversations never belong in Git.
**/*.jsonl
**/*.log
**/baseten-key.py
**/auth.json
**/real.txt
