{
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": [
        "--python",
        "python3",
        "mcp-for-blender==2.2.6"
      ],
      "env": {
        "BLENDER_HOST": "127.0.0.1",
        "BLENDER_PORT": "9876",
        "BLENDER_MCP_SAFE_MODE": "1",
        "DISABLE_TELEMETRY": "true"
      },
      "exposure": "direct",
      "timeout": 600
    }
  }
}
