# Xcode / generated project
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
dist/
*.xcuserstate

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# Secrets (never commit API keys)
*.env
.env.*
Secrets.plist
*.pem
*.p12
*.p8
*.key

# Local model downloads stay outside source control
*.gguf
*.pte
*.safetensors

# Local Python and JavaScript caches/dependencies
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
node_modules/

# Unreal generated build products (source assets remain tracked)
Unreal/**/Binaries/
Unreal/**/Intermediate/
Unreal/**/Saved/
Unreal/**/DerivedDataCache/
Unreal/**/.vs/
